# ─── Supabase ────────────────────────────────────────────────────────────────
# Trouvez ces valeurs dans : Supabase Dashboard > Project Settings > API

# URL publique du projet (safe côté client)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Clé anon (safe côté client — RLS vous protège)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Clé service_role (⚠ SECRÈTE — jamais exposée côté client)
# Utilisée uniquement par : ingest/scripts/load.ts
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── Anthropic ────────────────────────────────────────────────────────────────
# Utilisée par : src/app/api/case-feedback/route.ts (feedback LLM case_structuring / market_sizing)
# Trouvez la clé dans : https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-...

# ─── URL de déploiement ───────────────────────────────────────────────────────
# Utilisée par : reset password — redirectTo dans src/app/login/actions.ts
# En local : http://localhost:3000
# En prod   : https://votre-app.vercel.app
# Configurez aussi dans Supabase Dashboard > Authentication > URL Configuration > Site URL
NEXT_PUBLIC_SITE_URL=https://votre-app.vercel.app
